---
import '../styles/tokens.css';
import '../styles/global.css';
import { NOME, DESCRICAO, CATEGORIAS, MENU, LANCADO, url, absoluta, dataCabecalho } from '../lib/site';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;        // caminho dentro do site (ex.: /capas/2026/10/x.webp)
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  publicado?: Date;
  atualizado?: Date | null;
  jsonld?: Record<string, unknown> | null;
  secaoAtual?: string;
}
const { titulo, descricao = DESCRICAO, imagem = '/og-padrao.png', imagemAlt = NOME, tipo = 'website', publicado, atualizado, jsonld = null, secaoAtual } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${NOME}` : `${NOME}: negócios e tecnologia para a sua empresa`;
// canonica sempre com barra final nas paginas (igual ao sitemap)
const caminhoPagina = /\/$|\.[a-z0-9]+$/i.test(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname + '/';
const canonica = new URL(caminhoPagina, Astro.site).href;
const imagemAbs = absoluta(imagem, Astro.site);
// Trocar de variacao visual: mudar esta linha junto com src/styles/tokens.css
const FONTES_GOOGLE = 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;600&display=swap';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {!LANCADO && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={NOME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? NOME} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemAbs} />
    <meta property="og:image:alt" content={imagemAlt} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {atualizado && <meta property="article:modified_time" content={atualizado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo ?? NOME} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemAbs} />
    <link rel="alternate" type="application/rss+xml" title={NOME} href={absoluta('/rss.xml', Astro.site)} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/icone-32.png')} />
    <link rel="apple-touch-icon" href={url('/icone-180.png')} />
    <meta name="theme-color" content="#f5f2eb" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTES_GOOGLE} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header>
      <div class="cab">
        <a class="marca" href={url('/')} aria-label={`${NOME}, página inicial`}><span class="radar" aria-hidden="true"></span><span>Radar <em>Expanda</em></span></a>
        <p class="data-cab"><span data-hoje>{dataCabecalho()}</span> · negócios e tecnologia</p>
        <script is:inline>(function(){try{var e=document.querySelector("[data-hoje]");if(e)e.textContent=new Intl.DateTimeFormat("pt-BR",{timeZone:"America/Sao_Paulo",weekday:"long",day:"2-digit",month:"long"}).format(new Date());}catch(_){}})();</script>
      </div>
      <nav class="secoes" aria-label="Seções">
        {MENU.map((c) => (
          <a href={url(`/categoria/${c}/`)} aria-current={secaoAtual === c ? 'page' : undefined}>{CATEGORIAS[c]}</a>
        ))}
      </nav>
    </header>
    <main id="conteudo" class="envelope">
      <slot />
    </main>
    <footer class="rodape">
      <nav aria-label="Institucional">
        <a href={url('/sobre/')}>Sobre</a>
        <a href={url('/correcoes-e-remocao/')}>Correções e remoção</a>
        <a href={url('/rss.xml')}>RSS</a>
      </nav>
      <p>{NOME} · feito pela Expanda</p>
    </footer>
  </body>
</html>
