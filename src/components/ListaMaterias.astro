---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIAS, url, caminho, dataHora } from '../lib/site';

interface Props { materias: CollectionEntry<'materias'>[]; }
const { materias } = Astro.props;
---
<ol class="lista">
  {materias.map((m) => (
    <li>
      <div>
        <a class="chap" href={url(`/categoria/${m.data.categoria}/`)}>{CATEGORIAS[m.data.categoria]}</a>
        <h3><a href={url(caminho(m))}>{m.data.titulo}</a></h3>
        <p class="meta"><time datetime={m.data.data.toISOString()}>{dataHora(m.data.data)}</time></p>
      </div>
    </li>
  ))}
</ol>
