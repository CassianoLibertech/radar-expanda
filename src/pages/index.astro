---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ListaMaterias from '../components/ListaMaterias.astro';
import { CATEGORIAS, url, caminho, ordenadas, dataHora } from '../lib/site';

const todas = ordenadas(await getCollection('materias'));
const [manchete, ...resto] = todas;
const destaques = resto.slice(0, 5);
const mais = resto.slice(5, 40);
---
<Base>
  {!manchete && (
    <section class="vazio">
      <h1>Primeiras matérias em breve</h1>
      <p>Notícias de negócios e tecnologia confirmadas em mais de uma fonte, com o que muda para a sua empresa.</p>
    </section>
  )}
  {manchete && (
    <div class="home">
      <article class="manchete">
        <a href={url(caminho(manchete))} tabindex="-1" aria-hidden="true">
          <img class="capa" src={url(manchete.data.capa)} alt={manchete.data.capa_alt} width="1200" height="630" />
        </a>
        <a class="chap" href={url(`/categoria/${manchete.data.categoria}/`)}>{CATEGORIAS[manchete.data.categoria]}</a>
        <a class="tit" href={url(caminho(manchete))}><h2>{manchete.data.titulo}</h2></a>
        <p class="linha">{manchete.data.linha_fina}</p>
        <p class="meta"><time datetime={manchete.data.data.toISOString()}>{dataHora(manchete.data.data)}</time></p>
        <p class="angulo"><b>O que muda para a sua empresa</b>{manchete.data.angulo}</p>
      </article>
      <aside>
        {destaques.length > 0 && <p class="coluna-titulo">Também agora</p>}
        <ListaMaterias materias={destaques} />
      </aside>
    </div>
  )}
  {mais.length > 0 && (
    <section>
      <p class="coluna-titulo">Mais recentes</p>
      <ListaMaterias materias={mais} />
    </section>
  )}
</Base>
