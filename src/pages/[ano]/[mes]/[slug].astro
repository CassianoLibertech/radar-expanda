---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { NOME, CATEGORIAS, url, absoluta, partes, dataHora } from '../../../lib/site';

export async function getStaticPaths() {
  const todas = await getCollection('materias');
  return todas.map((m) => ({ params: partes(m), props: { m } }));
}
const { m } = Astro.props;
const d = m.data;
const { Content } = await render(m);
const canonica = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.titulo,
  description: d.linha_fina,
  datePublished: d.data.toISOString(),
  dateModified: (d.atualizado ?? d.data).toISOString(),
  image: [absoluta(d.capa, Astro.site)],
  mainEntityOfPage: canonica,
  articleSection: CATEGORIAS[d.categoria],
  inLanguage: 'pt-BR',
  author: { '@type': 'Organization', name: NOME, url: absoluta('/', Astro.site) },
  publisher: { '@type': 'Organization', name: NOME, logo: { '@type': 'ImageObject', url: absoluta('/icone-512.png', Astro.site) } },
  citation: d.fontes.map((f) => ({ '@type': 'CreativeWork', name: f.nome, url: f.url })),
};
---
<Base titulo={d.titulo} descricao={d.linha_fina} imagem={d.capa} imagemAlt={d.capa_alt} tipo="article"
      publicado={d.data} atualizado={d.atualizado ?? null} jsonld={jsonld} secaoAtual={d.categoria}>
  <article class="materia">
    <p class="fontes">Fontes:{' '}
      {d.fontes.map((f, i) => (
        <>{i > 0 && ' · '}<a href={f.url} rel="noopener nofollow" target="_blank">{f.nome}</a></>
      ))}
    </p>
    <a class="chap" href={url(`/categoria/${d.categoria}/`)}>{CATEGORIAS[d.categoria]}</a>
    <h1>{d.titulo}</h1>
    <p class="linha">{d.linha_fina}</p>
    <p class="meta">
      <time datetime={d.data.toISOString()}>{dataHora(d.data)}</time>
      {d.atualizado && <> · atualizado em <time datetime={d.atualizado.toISOString()}>{dataHora(d.atualizado)}</time></>}
    </p>
    <figure>
      <img src={url(d.capa)} alt={d.capa_alt} width="1200" height="630" />
      <figcaption>Arte: {NOME}</figcaption>
    </figure>
    <div class="corpo">
      <Content />
    </div>
  </article>
</Base>
